export function filterRequests(requests, {status = 'All', query = ''} = {}) {
  // Starter: displays all rows. Filtering and search are your Cycle 1 task.
  return requests.slice();
}


export function filterRequests(
  requests,
  { status = 'All', query = '' } = {}
) {
  const normalizedQuery =
    typeof query === 'string' ? query.trim().toLowerCase() : '';

  return requests.filter(request => {
    const matchesStatus =
      status === 'All' || request.status === status;

    const matchesQuery =
      request.id.toLowerCase().includes(normalizedQuery);

    return matchesStatus && matchesQuery;
  });
}

export function transitionRequest(
  requests,
  id,
  nextStatus,
  actor,
  { reason = '' } = {}
) {
  const current = requests.find(item => item.id === id);

  if (!current) {
    return {
      ok: false,
      requests,
      error: 'Request not found.'
    };
  }

  const allowedTransitions = {
    'Awaiting review': ['Processing', 'Cancelled'],
    'Processing': ['Ready', 'Cancelled'],
    'Ready': ['Collected', 'Cancelled'],
    'Collected': [],
    'Cancelled': []
  };

  if (!Object.hasOwn(allowedTransitions, current.status)) {
    return {
      ok: false,
      requests,
      error: 'Unknown current status.'
    };
  }

  if (!Object.hasOwn(allowedTransitions, nextStatus)) {
    return {
      ok: false,
      requests,
      error: 'Invalid next status.'
    };
  }

  if (current.status === nextStatus) {
    return {
      ok: false,
      requests,
      error: 'Request already has that status.'
    };
  }

  if (!allowedTransitions[current.status].includes(nextStatus)) {
    return {
      ok: false,
      requests,
      error: 'Status transition is not allowed.'
    };
  }

  const normalizedActor =
    typeof actor === 'string' ? actor.trim() : '';

  if (!normalizedActor) {
    return {
      ok: false,
      requests,
      error: 'Staff alias is required.'
    };
  }

  if (
    nextStatus === 'Ready' &&
    (
      current.identity !== 'verified' ||
      current.authorisation !== 'verified'
    )
  ) {
    return {
      ok: false,
      requests,
      error: 'Identity and authorisation must both be verified before marking a request Ready.'
    };
  }

  // CR-03: Validate the cancellation reason.
  if (nextStatus === 'Cancelled') {
    const normalizedReason =
      typeof reason === 'string' ? reason.trim() : '';

    if (normalizedReason.length < 10) {
      return {
        ok: false,
        requests,
        error: 'Cancellation reason must be at least 10 characters.'
      };
    }

    reason = normalizedReason;
  }

  const changed = {
    ...current,
    status: nextStatus
  };

  const updatedRequests = requests.map(item =>
    item.id === id ? changed : item
  );

  const event = {
    requestId: id,
    from: current.status,
    to: nextStatus,
    actor: normalizedActor,
    at: new Date().toISOString(),
    reason: nextStatus === 'Cancelled' ? reason : ''
  };

  return {
    ok: true,
    requests: updatedRequests,
    changed,
    event
  };
}
